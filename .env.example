# Absolute origin of the deployed site.
# Used for canonical URLs, Open Graph images, robots.txt, sitemap.xml, llms.txt
# and the Organization schema.
#
# Unset, this falls back to the production origin (https://codking.tech), so a
# deploy that forgets it still publishes correct URLs. Local development wants
# the line below; production may set it explicitly or rely on the fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Destinations outside this site (see src/constants/external.ts).
# Install Free is the primary action on every page and points at the Shopify
# App Store listing. Any value left unset renders as a disabled action rather
# than a dead link, so the site stays honest before these are confirmed.
NEXT_PUBLIC_SHOPIFY_APP_URL=
NEXT_PUBLIC_BOOK_DEMO_URL=
NEXT_PUBLIC_APP_LOGIN_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# The public demo storefront behind "Try Live Demo Store" on the homepage.
#
# A real Shopify store running COD King, so a visitor can take the
# cash-on-delivery checkout themselves. Distinct from NEXT_PUBLIC_BOOK_DEMO_URL
# above, which is the booking action and is reserved for the scheduler — the
# two are never pointed at the same place.
#
# Unset, this falls back to the published store, so the button works out of the
# box; the variable still wins, which is what staging needs.
NEXT_PUBLIC_DEMO_STORE_URL=

# The mailbox behind the contact form (src/app/api/contact/route.ts).
#
# Server-side only — deliberately not NEXT_PUBLIC_*, so Next.js never inlines
# any of it into the browser bundle. The key is read in
# src/lib/contact/mailer.ts and nowhere else.
#
# Delivery goes through Resend's HTTP API, which needs no dependency: the route
# posts JSON to it with fetch. With any of the three unset the route answers
# 503 and the form shows its "that did not send" panel pointing at WhatsApp —
# it never shows a success state for a message that was not delivered.

# API key from https://resend.com/api-keys. Never commit a real value.
RESEND_API_KEY=

# The sending identity. Must be an address on a domain verified with the
# provider, so it has no fallback — a guessed value is a message the provider
# rejects. Format: "Display Name <address@domain>" or a bare address.
CONTACT_EMAIL_FROM=

# Where enquiries land. Unset, this falls back to the support address the
# published legal pages already answer on (see src/constants/external.ts), so
# there is one support mailbox in this codebase rather than two.
CONTACT_EMAIL_TO=
