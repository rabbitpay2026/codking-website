# Absolute origin of the deployed site.
# Used for canonical URLs, Open Graph images, robots.txt, sitemap.xml, llms.txt
# and the Organization schema.
#
# Unset, this falls back to the production origin (https://codking.tech), so a
# deploy that forgets it still publishes correct URLs. Local development wants
# the line below; production may set it explicitly or rely on the fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Destinations outside this site (see src/constants/external.ts).
# Install Free is the primary action on every page and points at the Shopify
# App Store listing. Any value left unset renders as a disabled action rather
# than a dead link, so the site stays honest before these are confirmed.
NEXT_PUBLIC_SHOPIFY_APP_URL=
NEXT_PUBLIC_BOOK_DEMO_URL=
NEXT_PUBLIC_APP_LOGIN_URL=
NEXT_PUBLIC_WHATSAPP_URL=
